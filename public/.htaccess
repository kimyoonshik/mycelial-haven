# Apache (카페24·가비아·호스팅케이알 등 일반 웹호스팅) 설정
# dist/ 폴더의 내용을 웹 루트(public_html 등)에 그대로 올리면 이 파일도 함께 올라간다.
# 모든 공개 페이지는 빌드 때 실제 HTML 파일로 생성되므로(scripts/prerender.mjs) 주소 재작성 없이도 동작한다.

Options -Indexes
DirectoryIndex index.html

# /mycerra 처럼 끝에 / 가 없는 주소를 /mycerra/ 로 강제 이동하지 않는다 (아래 규칙이 index.html 로 연결)
DirectorySlash Off

# 없는 주소는 404 상태로 응답하고 사이트의 404 화면을 보여 준다 (검색엔진에 빈 페이지가 색인되지 않도록)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # [선택] SSL 인증서 적용 후 주석을 풀면 http → https, saveearth.kr → www.saveearth.kr 로 통일된다.
  # Cloudflare 등 프록시 뒤에서는 무한 이동이 생길 수 있으므로 프록시 설정에서 처리할 것.
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^saveearth\.kr$ [NC]
  # RewriteRule ^ https://www.saveearth.kr%{REQUEST_URI} [L,R=301]

  # 실제 파일(이미지, 페이지별 HTML 등)은 그대로 응답
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /mycerra, /shop/p/EM-01 → 빌드 때 생성된 페이지별 HTML
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # 빌드 산출물(/assets)은 파일명에 해시가 붙어 1년 캐시
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # 운영 도구로 교체되는 이미지·성적서(/media)는 1시간 캐시 후 갱신 확인
  <If "%{REQUEST_URI} =~ m#^/media/#">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </If>
  # HTML은 항상 최신 확인
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2
AddType text/javascript .js .mjs
