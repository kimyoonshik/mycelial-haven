# 서버 설정. install.sh 가 이 파일을 /etc/mycogen/server.env 로 복사하고 DB·관리자 비밀번호를 채웁니다.
# 고친 뒤에는 sudo systemctl restart mycogen. 이 파일(server.env)은 git 에 올리지 않습니다.

# PostgreSQL 접속 (install.sh 가 자동으로 채움)
DATABASE_URL=postgres://mycogen:비밀번호@127.0.0.1:5432/mycogen

# 사이트 출력 폴더(nginx 가 보여 주는 곳)와 관리 페이지에서 올린 이미지 폴더
DIST_DIR=/srv/mycogen/www
UPLOAD_DIR=/srv/mycogen/data/uploads

# 관리 페이지(https://info.mycogen.co.kr) 로그인. 비밀번호를 비워 두면 아무도 로그인할 수 없습니다.
ADMIN_USER=admin
ADMIN_PASSWORD=
# 로그인 유지용 비밀 값(install.sh 가 자동으로 채움). 비우면 서버를 다시 켤 때마다 다시 로그인해야 합니다.
SESSION_SECRET=
ADMIN_URL=https://info.mycogen.co.kr

# 문의 알림 메일 (SMTP, SSL 465 포트). 비워 두면 메일 없이 DB에만 기록합니다.
# 예) 네이버웍스 smtp.worksmobile.com / Gmail smtp.gmail.com / 다음 smtp.daum.net — 대부분 "앱 비밀번호"가 필요합니다.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=info@mycogen.co.kr

# 사이트 주소 (관리 페이지의 '사이트 보기', 네이버용 복사의 원문 링크)
SITE_URL=https://www.mycogen.co.kr

# 자동 등록 방지: Cloudflare 대시보드 → Turnstile → 위젯 추가(www.mycogen.co.kr)에서 발급. 둘 다 넣어야 켜집니다.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# 블로그 AI 초안 (Claude API). console.anthropic.com 에서 발급. 비우면 초안 기능만 꺼집니다.
ANTHROPIC_API_KEY=

# 선택
# PORT=4780
# ADMIN_PORT=4781
# RETAIN_DAYS=365
