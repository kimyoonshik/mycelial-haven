# /etc/systemd/system/mycogen-update.service  (install.sh 가 설치, mycogen-update.timer 가 5분마다 실행)
# GitHub main 에 새 내용이 있으면 받아서 서버를 다시 켭니다(다시 켜면 사이트도 새로 만들어짐).
[Unit]
Description=Mycogen: pull main from GitHub and restart when it changed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/srv/mycogen/app/mycogen/server/deploy/update.sh
